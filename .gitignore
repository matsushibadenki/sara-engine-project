# ディレクトリパス: .gitignore
# ファイル名: .gitignore
# 内容: sara-engine-project用のGit除外設定ファイル

# ============================================
# Python compiled files
# ============================================
__pycache__/
*.py[cod]
*$py.class

# ============================================
# Distribution / Packaging
# ============================================
# Generated and private models stay excluded. Only the two reviewed,
# deterministic research packages below are publication artifacts.
**/models/
!/models/
/models/*
!/models/bpi2012/
/models/bpi2012/*
!/models/bpi2012/sara-bpi2012-pretest-v1.sara
!/models/bpi2012/SHA256SUMS
!/models/bpi2012/manifest.json
!/models/sepsis/
/models/sepsis/*
!/models/sepsis/sara-sepsis-pretest-v1.sara
!/models/sepsis/SHA256SUMS
!/models/sepsis/manifest.json
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================
# Rust関連
# ============================================
sara_rust_core/target/
target/
Cargo.lock

# コンパイル済み共有ライブラリ
*.so
*.dylib

# ============================================
# Virtual Environments
# ============================================
venv/
env/
.env/
.venv/
ENV/

# ============================================
# Unit Test / Coverage / Type Check / Lint
# ============================================
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================
# Jupyter Notebook
# ============================================
.ipynb_checkpoints

# ============================================
# IDE / Editor
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# OS generated files
# ============================================
.DS_Store
Thumbs.db

# ============================================
# Gemini AI
# ============================================
.gemini/

# ============================================
# Project Specific
# ============================================

# データセット
examples/data/

# data area
data/*.gz
data/*.csv
data/*.db

# 学習済みモデル
*.pkl
*.msgpack

# Logs
*.log

# 作業領域。再現性に必要な、レビュー済みの最終研究結果だけを公開する。
**/workspace/
!/workspace/
/workspace/*
!/workspace/evaluation/
/workspace/evaluation/*
!/workspace/evaluation/r2_bpi2012_hybrid_final_v1_result.json
!/workspace/evaluation/r2_sepsis_normalized_final_v1_result.json
!/workspace/evaluation/research_package_verification_v1.json

# 整理・分類された古いファイル群
scripts/old/
data/old/
examples/old/
tests/old/
